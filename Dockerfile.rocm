# ROCm vLLM development image published for Radeon GPUs. This tag uses Python 3.12,
# which is within rigtune-amd's supported range.
# Override BASE_IMAGE to use another AMD-supported ROCm/vLLM image.
ARG BASE_IMAGE=rocm/vllm-dev:rocm7.2.1_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.16.0
FROM ${BASE_IMAGE}

WORKDIR /opt/rigtune
COPY pyproject.toml README.md LICENSE ./
COPY rigtune ./rigtune
RUN python3 -m pip install --no-cache-dir .

EXPOSE 8000
ENV RIGTUNE_HOST=0.0.0.0
ENTRYPOINT ["rigtune"]
CMD ["--help"]
